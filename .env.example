# ============================================================
# acra 环境变量样例  —— 复制为 .env 后填写真实值
# .env 已在 .gitignore 中，切勿提交
# ============================================================

# ---------- 平台接入（阶段一为 CLI 本地模式，可全部留空）----------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# ---------- 模型（OpenAI 兼容协议）----------
# 小米 MiMo 开放平台：https://api.xiaomimimo.com/v1
# 注意：MiMo 的思考 token 计入 max_completion_tokens，预算过小会导致正文为空
LLM_API_BASE=https://api.xiaomimimo.com/v1
LLM_API_KEY=
LLM_SCAN_MODEL=mimo-v2.5-pro
LLM_VERIFY_MODEL=mimo-v2.5-pro
LLM_SUMMARY_MODEL=mimo-v2.5-pro
LLM_TIMEOUT_SECONDS=60
LLM_MAX_COMPLETION_TOKENS=8192
LLM_MAX_RETRIES=2

# 单价（微美元 / 1M tokens），用于成本统计；不填则成本记 0
LLM_INPUT_PRICE_MICROS_PER_MTOK=0
LLM_OUTPUT_PRICE_MICROS_PER_MTOK=0

# ---------- 存储 ----------
# 留空则自动降级为 SQLite（$ACRA_WORKDIR/acra.db），无需 Docker 即可跑 CLI
DATABASE_URL=
# 留空则使用进程内缓存/内存队列；填了才启用 Redis
REDIS_URL=

# ---------- 行为 ----------
ACRA_MAX_COMMENTS=5
ACRA_CONFIDENCE_THRESHOLD=0.65
ACRA_CONTEXT_LEVEL_MAX=2
ACRA_CONTEXT_CONTEXT_LINES=3
ACRA_DAILY_BUDGET_MICROS=5000000
ACRA_TOTAL_INPUT_TOKEN_BUDGET=200000
ACRA_CHUNK_INPUT_TOKEN_BUDGET=16000
ACRA_MAX_CHANGED_LINES=3000
ACRA_MAX_CHANGED_FILES=80
ACRA_SCAN_CONCURRENCY=4
ACRA_SANDBOX_IMAGE=acra-sandbox:latest
ACRA_SANDBOX_ENABLED=false
ACRA_SHADOW_MODE=false
ACRA_WORKDIR=.acra-work

# ---------- 观测 ----------
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
